# Editor settings shared by every editor; Prettier and rustfmt follow the same choices.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

# rustfmt's defaults (rustfmt.toml).
[*.rs]
indent_size = 4
max_line_length = 100

# A trailing double space is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
